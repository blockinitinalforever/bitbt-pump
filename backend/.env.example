# Required — load from a secret store / protected env file (do not inline on the CLI)
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/bitbt

# Optional server
PORT=3100
# Session lifetime in hours (1–12)
SESSION_TTL_HOURS=12

# Login rate limit (failed attempts only): max 1–50, window 60–86400 seconds
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECS=900

# Contact rate limit (per IP, all attempts): max 1–100, window 60–86400 seconds
CONTACT_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_WINDOW_SECS=600

# Official verification rate limit (per IP, all attempts)
VERIFICATION_RATE_LIMIT_MAX=30
VERIFICATION_RATE_LIMIT_WINDOW_SECS=60

# Contact form email — leave SMTP_USER/SMTP_PASS empty to disable mail
CONTACT_EMAIL=support@bitbt.com
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtpout.secureserver.net

# bootstrap_admin: omit ADMIN_BOOTSTRAP_PASSWORD to auto-generate (>=24 chars).
# If overriding, inject via secret manager — do not put the password on the command line.
# ADMIN_BOOTSTRAP_FORCE=1
